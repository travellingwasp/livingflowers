<BaseLayout
  title="East-Facing Window Plants: Morning-Sun Placement Guide"
  description="Choose plants for an east-facing window using practical distance zones, morning-sun tolerance, warning signs, and apartment-specific placement advice."
  canonicalPath="/east-facing-window-plants/"
